# ─────────────────────────────────────────────────────────────────────────────
# SOFTWARE FACTORY: three browser games, built at the same time by make_game.
#
# make_game is factory/game.jig used as one step (commands/make_game.yaml): for one
# requirements file it runs specify, build, test, verify, up to 2 fix rounds and
# review, and hands back {id, tests, verdict, fixes, review}.
#
#   py -m jig run factory/factory.jig --continue-on-error
#
# each= runs make_game once per game, each in its own process, parallel= at a time,
# and waits for all of them. The results come back as a list, in the same order.
# Three games take about as long as one (about 5 minutes, about $1 each).
# ─────────────────────────────────────────────────────────────────────────────

GAMES = [{"id": "PONG-003", "file": "pong.md"},
         {"id": "TETRIS-002", "file": "tetris.md"},
         {"id": "SNAKE-002", "file": "snake.md"}]

# One line starts all three and waits until every game has finished.
results = make_game(each=GAMES, parallel=3)

passed = []
for r in results:
    # A game that still fails after its fix rounds is reported; the others still count.
    if r.status == "completed":
        passed.append(r.output.id)
    elif r.output and "tests" in r.output:
        print(f"{r.output.id} needs a look: tests {r.output.tests}, verify {r.output.verdict}")
    else:
        print("a game stopped early; see its record in .jig/")

print(f"{len(passed)} of {len(GAMES)} games pass: {passed}")
# The factory run counts as failed unless every game passes.
if len(passed) != len(GAMES):
    fail(f"{len(GAMES) - len(passed)} game(s) did not pass")
