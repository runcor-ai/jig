{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "build",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements_implemented": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "not_implemented"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "requirement",
          "status",
          "evidence_paths",
          "notes"
        ]
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "outcome"
        ]
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run_instructions": {
      "type": "string"
    }
  },
  "required": [
    "summary",
    "files_created",
    "requirements_implemented",
    "commands_run",
    "known_gaps",
    "run_instructions"
  ]
}