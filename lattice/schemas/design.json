{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "design",
  "type": "object",
  "properties": {
    "overview": {
      "type": "string"
    },
    "architecture_style": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-\\d{2,3}$"
          },
          "name": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "responsibility",
          "technology",
          "path"
        ]
      },
      "minItems": 1
    },
    "data_model": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "constraints": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type",
                "constraints"
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "entity",
          "table",
          "fields",
          "notes"
        ]
      },
      "minItems": 1
    },
    "api": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "method",
          "path",
          "description",
          "roles",
          "requirements"
        ]
      },
      "minItems": 1
    },
    "security": {
      "type": "object",
      "properties": {
        "authentication": {
          "type": "string"
        },
        "authorization": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "permissions"
            ]
          }
        },
        "audit": {
          "type": "string"
        },
        "secrets": {
          "type": "string"
        }
      },
      "required": [
        "authentication",
        "authorization",
        "roles",
        "audit",
        "secrets"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-\\d{2,3}$"
          },
          "question": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reversibility": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "question",
          "decision",
          "rationale",
          "alternatives",
          "reversibility"
        ]
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "requirement",
          "components",
          "endpoints",
          "notes"
        ]
      },
      "minItems": 1
    },
    "test_strategy": {
      "type": "object",
      "properties": {
        "backend_unit": {
          "type": "string"
        },
        "backend_integration": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        }
      },
      "required": [
        "backend_unit",
        "backend_integration",
        "frontend"
      ]
    },
    "repository_layout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "purpose"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "overview",
    "architecture_style",
    "components",
    "data_model",
    "api",
    "security",
    "decisions",
    "traceability",
    "test_strategy",
    "repository_layout"
  ]
}