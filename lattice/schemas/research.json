{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research",
  "type": "object",
  "required": [
    "summary",
    "findings",
    "sources",
    "open_questions",
    "method"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "confidence",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{2,3}$"
          },
          "claim": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-\\d{2,3}$"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string",
            "description": "Short passage from the source supporting the findings that cite it"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method": {
      "type": "string",
      "description": "Searches run and pages read"
    }
  }
}