{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "satisfied",
              "partial",
              "not_satisfied",
              "unverifiable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "symbol": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "file",
                "note"
              ]
            }
          },
          "test_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence",
          "test_evidence",
          "notes"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "summary",
    "items"
  ]
}