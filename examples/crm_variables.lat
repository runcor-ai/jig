# The same pipeline using a variable binding instead of a literal id, with a pinned
# profile version and an explicit override.
crm = requirement("Build a customer management application",
                  stack=["Java", "React", "PostgreSQL"],
                  standard="enterprise@1.0.0",
                  overrides={"quality.documentation": true})
design(crm, decision_model="architecture_selection")
build(crm)
test(crm)
review(crm, criteria=["security", "architecture", "maintainability"])
verify(crm, against="requirements")
