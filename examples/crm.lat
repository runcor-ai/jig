# CRM reference demonstration (spec section 14). Run with:
#   py -m lattice run examples/crm.lat
requirement(
    "Build a customer management application",
    stack=["Java", "React", "PostgreSQL"],
    standard="enterprise"
)

design("CRM-001")
build("CRM-001")
test("CRM-001")
review("CRM-001", criteria=["security", "architecture"])
verify("CRM-001", against="requirements")
