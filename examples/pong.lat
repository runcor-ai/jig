# Simple Pong game. Run with:  py -m lattice run examples/pong.lat
spec = specify("A simple Pong game in the browser: two paddles, a ball, score to 10, "
               "player vs computer, keyboard controls, restart button",
               constraints=["React + TypeScript + Vite, no backend",
                            "Vitest + @testing-library/react with jsdom for tests"],
               id="PONG-001")

build(spec, test_run=["npm install --no-audit --no-fund",
                      "npx vitest run --reporter=junit --outputFile=test-results/junit.xml",
                      "npm run build"])

test(spec, run=["npm install --no-audit --no-fund",
                "npx vitest run --reporter=junit --outputFile=test-results/junit.xml",
                "npm run build"],
     expect_files=["dist/index.html"])

verify(spec)
review(spec, criteria=["correctness", "readability"])   # user command from ./commands/
